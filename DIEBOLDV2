# =====================================================================
# PARSER DIEBOLD EJ  ->  NODO "PYTHON SCRIPT" DE KNIME
# Salidas (4 puertos):
#   0 -> Débitos EXITOSOS      (RespCode 000/001 y Monto != 0)
#   1 -> Trx NO exitosas       (RespCode distinto de 000 y 001)
#   2 -> Eventos del ATM       (incluye LECTURA_TARJETA: fallas de chip)
#   3 -> Control de CASH        (cómo va bajando por transacción)
# =====================================================================

import re
import pandas as pd
import knime.scripting.io as knio
from pathlib import Path
from datetime import datetime


# ---------------------------------------------------------------------
# 1. ENTRADA  (flow variable de KNIME)
# ---------------------------------------------------------------------
CARPETA_LOGS = Path(knio.flow_variables["RutaATM"])

# ---------------------------------------------------------------------
# 2. REGEX PRE-COMPILADOS
# ---------------------------------------------------------------------
RE_HORA      = re.compile(r"(\d{2}:\d{2}:\d{2})")
RE_TRX_START = re.compile(r"(\d{2}:\d{2}:\d{2}).*TRANSACTION START", re.I)
RE_TRX_END   = re.compile(r"(\d{2}:\d{2}:\d{2}).*TRANSACTION END", re.I)
RE_DATE      = re.compile(r"(\d{2}/\d{2}/\d{2})\s+(\d{2}:\d{2})")
RE_CASH = re.compile(
    r"(\d+):\d+,(\d+)"
)
RE_REMAINING = re.compile(r"([1-4])-[A-Z].*?(\d+)\*?$")

RE_RECIBO_FECHA = re.compile(
    r"(\d{2}/\d{2}/\d{2})\s+(\d{2}:\d{2})\s+([A-Z0-9]+)"
)

RE_RECORD_NO = re.compile(
    r"\*RECORD NO\.\s+(\d+)"
)

RE_WITHDRAWAL = re.compile(
    r"\*WITHDRAWAL\s+\$([\d,]+\.\d+)"
)

RE_FEE = re.compile(
    r"\*FEE\s+\$([\d,]+\.\d+)"
)

# --- NUEVO: lectura de chip ---
RE_SMART   = re.compile(r"(\d{2}:\d{2}:\d{2})\s+SMART\s+-+\s+(\d+)")
RE_EMV_AID = re.compile(r"EMV AID\s+([A-F0-9]+)", re.I)

# ---------------------------------------------------------------------
# 3. CATÁLOGOS
# ---------------------------------------------------------------------
ALERTA_POR_RESP = {
