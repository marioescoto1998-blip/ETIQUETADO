# ---------------------------------------------------------------------
# 2. REGEX PRE-COMPILADOS
# ---------------------------------------------------------------------
RE_HORA      = re.compile(r"(\d{2}:\d{2}:\d{2})")
RE_TRX_END   = re.compile(r"(\d{2}:\d{2}:\d{2}).*TRANSACTION END", re.I)
RE_DATE      = re.compile(r"(\d{2}/\d{2}/\d{2})\s+(\d{2}:\d{2})")

# Encabezado de evento NCR:  *139*06/23/2026*09:09*   (MM/DD/YYYY)
RE_EVENTO_NCR = re.compile(r"\*(\d+)\*(\d{2}/\d{2}/\d{4})\*(\d{2}:\d{2})\*")

# Efectivo por transacción
RE_NOTES_PRESENTED = re.compile(r"NOTES PRESENTED\s+(\d+),(\d+),(\d+),(\d+)", re.I)
RE_REMAINING_NCR   = re.compile(r"^REMAINING\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)", re.I)

# Bloques de supervisor
RE_TYPE_VALOR   = re.compile(r"TYPE\s*(\d)\s*=\s*(\d+)", re.I)
RE_FILA_REPORTE = re.compile(
    r"^[+=]?\s*(CASSETTE|REJECTED|REMAINING|DISPENSED|TOTAL)\s+(\d+)\s+(\d+)\s*$", re.I
)
RE_DATETIME_REP = re.compile(r"DATE-TIME\s*=\s*(\d{2}/\d{2}/\d{2})\s+(\d{2}:\d{2})", re.I)
RE_LAST_CLEARED = re.compile(r"LAST CLEARED\s+(\d{2}/\d{2}/\d{2}\s+\d{2}:\d{2})", re.I)
RE_CARDS_CAPT   = re.compile(r"CARDS CAPTURED\s+(\d+)", re.I)
RE_ACTIVITY     = re.compile(r"ACTIVITY COUNT\s*=\s*(\d+)", re.I)
RE_FECHA_TAREA  = re.compile(
    r"(\d{1,2})/(\d{1,2})/(\d{4})\s+(\d{1,2}):(\d{2}):(\d{2})\s*(AM|PM)", re.I
)
RE_CASETE_INFO  = re.compile(r"^(TOP|SECOND|THIRD|FOURTH)\s+(\w+)\s+(\d+)\s+(\d+)\s+(\w+)", re.I)

# ATM_ADMIN: reporte de totales por casetero (C1..C4 STR/INC/DEC/OUT/END)
RE_ADMIN_FECHA = re.compile(r"(\d{2}/\d{2}/\d{2})\s+(\d{2}:\d{2})\s+(SHN\d+)", re.I)
RE_ADMIN_STR   = re.compile(r"C(\d)\s+STR\s+[\$,]*([\d,]+)", re.I)
RE_ADMIN_INC   = re.compile(r"\*INC\s+[\$,]*([\d,]+)\s+\*DEC\s+[\$,]*([\d,]+)", re.I)
RE_ADMIN_OUT   = re.compile(r"\*OUT\s+[\$,]*([\d,]+)\s+\*END\s+[\$,]*([\d,]+)", re.I)

RE_GENAC2   = re.compile(r"GENAC 2\s*:\s*(\w+)", re.I)
RE_ATM_ANY  = re.compile(r"\b(SHN\d{5})\b", re.I)

# Códigos de control de impresión NCR: ESC  [020t  [05p  [00p  (I  (1  )1
RE_CTRL_NCR = re.compile(r"\x1b|\[\d{2,3}[a-zA-Z]|\((?:I|1)|\)1")


