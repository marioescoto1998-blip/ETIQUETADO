# ---------------------------------------------------------------------
# 4. HELPERS
# ---------------------------------------------------------------------
def hora_de(linea: str):
    m = RE_HORA.search(linea)
    return m.group(1) if m else None


def limpiar(texto):
    """Quita los códigos de control de impresión NCR."""
    return RE_CTRL_NCR.sub("", texto).strip()


def fecha_mdy_a_dmy(fecha):
    """06/23/2026 o 06/23/26 (MM/DD) -> 23/06/26 (mismo formato que las trx)."""
    try:
        mm, dd, yy = fecha.split("/")
        return f"{int(dd):02d}/{int(mm):02d}/{yy[-2:]}"
    except Exception:
        return fecha


def a_num(txt):
    txt = (txt or "").replace(",", "").strip()
    return int(txt) if txt.isdigit() else 0


def minutos_entre(h1, h2):
    try:
        t1 = datetime.strptime(h1, "%H:%M:%S" if len(h1) == 8 else "%H:%M")
        t2 = datetime.strptime(h2, "%H:%M:%S" if len(h2) == 8 else "%H:%M")
        return int((t2 - t1).total_seconds() // 60)
    except Exception:
        return None


def denom_atm(atmid):
    return DENOM_NCR_POR_ATM.get(atmid, DENOM_NCR_DEFAULT)


def fmt4(valores):
    return "/".join(str(valores[k]) if k in valores else "-" for k in range(1, 5))


def obtener_atmid(lineas):
    for linea in lineas:
        if "ATMID" in linea.upper():
            try:
                valor = linea.split(":", 1)[1].strip()
                return valor.split("-")[0].strip()
            except Exception:
                pass
    for linea in lineas:
        m = RE_ATM_ANY.search(linea)
        if m:
            return m.group(1).upper()
    return None


def primera_fecha(lineas):
    for linea in lineas:
        m = RE_EVENTO_NCR.search(linea)
        if m:
            return fecha_mdy_a_dmy(m.group(2))
    return None


