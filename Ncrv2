def clasificar_evento_ncr(u):

    # "CASSETTE INFORMATION WAS NOT DISPLAYED" no es un evento
    if "WAS NOT DISPLAYED" in u:
        return None

    # Encabezado del reporte ATM_ADMIN:  DIA  HORA  CAJERO
    if "CAJERO" in u and "HORA" in u and "DIA" in u:
        return "ATM_ADMIN"

    for texto, evento in EVENTOS_CLAVE_NCR.items():

        if texto in u:
            return evento

    return None


def categoria_evento_ncr(evento):

    for categoria, lista in CATEGORIAS_NCR.items():
        if evento in lista:
            return categoria

    return "OTRO"


