# =====================================================================
# PARSER NCR EJ  ->  NODO "PYTHON SCRIPT" DE KNIME
# Salidas (4 puertos):
#   0 -> Débitos EXITOSOS      (RespCode 000/001 y Monto != 0)
#   1 -> Trx NO exitosas       (RespCode distinto de 000 y 001)
#   2 -> Eventos del ATM       (operación, supervisor, efectivo y controles)
#   3 -> Control de CASH        (cómo va bajando por transacción)
#
# Las columnas de los 4 puertos NO cambian. Lo nuevo son más tipos de
# evento en el puerto 2 y valores corregidos de efectivo por transacción.
# =====================================================================

import re
import pandas as pd
import knime.scripting.io as knio
from pathlib import Path
